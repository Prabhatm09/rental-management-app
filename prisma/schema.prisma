generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String?
  motorInitialReading Float @default(0)
  motorChargePerUnit  Float @default(8)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())

  units RentalUnit[]
  readings PropertyMonthlyReading[]
}

model RentalUnit {
  id         String   @id @default(cuid())
  name       String
  participatesInMotor Boolean @default(true)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  tenants Tenant[]

  createdAt DateTime @default(now())
}

model Tenant {
  id String @id @default(cuid())

  name  String
  phone String?

  rentalUnitId String
  rentalUnit   RentalUnit @relation(fields: [rentalUnitId], references: [id])

  startMonth DateTime

  isActive Boolean @default(true)

  monthlyRent Float

  initialElectricReading Float
  initialMotorReading     Float @default(0)

  electricChargePerUnit Float

  bills Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  propertyReadingId String?
  propertyReading   PropertyMonthlyReading? @relation(fields: [propertyReadingId], references: [id])

  month DateTime

  rent Float

  electricPrevious Float
  electricCurrent Float
  electricUnits Float

  motorPrevious Float
  motorCurrent Float
  motorUnits Float
  motorTotalUnits Float @default(0)
  motorShareUnits Float @default(0)
  motorShareTenantCount Int @default(1)

  electricChargePerUnit Float
  electricAmount Float @default(0)
  calculatedElectricAmount Float @default(0)
  electricAdjustmentAmount Float @default(0)
  finalElectricAmount Float @default(0)

  motorRate Float
  motorAmount Float @default(0)
  calculatedMotorAmount Float @default(0)
  motorAdjustmentAmount Float @default(0)
  finalMotorAmount Float @default(0)

  adjustmentAmount Float @default(0)
  otherAdjustmentAmount Float @default(0)

  total Float
  paidAmount Float @default(0)
  dueAmount Float @default(0)
  status String @default("UNPAID")
  shareMessage String?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, month])
}

model Payment {
  id String @id @default(cuid())

  billId String
  bill   Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount Float
  method String?
  transactionReference String?
  note   String?
  paidAt DateTime @default(now())

  createdAt DateTime @default(now())
}

model PropertyMonthlyReading {
  id String @id @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  month DateTime

  governmentPreviousReading Float
  governmentCurrentReading Float
  governmentUnits Float

  motorPreviousReading Float
  motorCurrentReading Float
  motorUnits Float

  governmentBillAmount Float @default(0)
  governmentOutstanding Float @default(0)

  bills Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, month])
}
